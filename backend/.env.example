# База данных
DATABASE_URL=postgresql://user:password@localhost:5432/autohub_ai

# CORS (разрешенные origins)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# AI настройки (для будущего)
VERTEX_AI_API_KEY=your_api_key_here
VERTEX_AI_ENDPOINT=https://your-vertex-endpoint.com
VERTEX_AI_MODEL=gemini-2.0-flash-exp

# Настройки загрузки файлов
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880
MAX_PHOTOS_PER_LISTING=10
