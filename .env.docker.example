# ======================================
# AutoHub AI - Docker Environment Variables
# ======================================
# Скопируйте этот файл как .env и заполните своими значениями
# cp .env.docker.example .env

# ======================================
# PostgreSQL Configuration
# ======================================
POSTGRES_DB=autohub_ai
POSTGRES_USER=autohub_user
POSTGRES_PASSWORD=autohub_password_2024
POSTGRES_PORT=5432

# ======================================
# Database Connection Pool
# ======================================
DB_POOL_MIN_SIZE=5
DB_POOL_MAX_SIZE=20

# ======================================
# CORS Configuration
# ======================================
# ВАЖНО: Укажите фронтенд URL для CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ======================================
# Google Vertex AI / Gemini Configuration
# ======================================
# ОБЯЗАТЕЛЬНО: Заполните данными вашего проекта
VERTEX_AI_PROJECT_ID=your-project-id-here
VERTEX_AI_LOCATION=us-central1
VERTEX_AI_CREDENTIALS_PATH=/app/credentials/credentials.json
AI_MODEL=google/gemini-2.5-pro

# ======================================
# Admin Panel
# ======================================
# Токен для доступа к админ-панели (MVP - простая авторизация)
ADMIN_TOKEN=simple-token-for-mvp

# ======================================
# File Upload Settings
# ======================================
MAX_FILE_SIZE=5242880
MAX_PHOTOS_PER_LISTING=10

# ======================================
# Frontend Configuration
# ======================================
# URL для доступа к Backend API (из браузера)
NEXT_PUBLIC_API_URL=http://localhost:8000

# ======================================
# Ports Configuration
# ======================================
FRONTEND_PORT=3000
BACKEND_PORT=8000

# ======================================
# ИНСТРУКЦИИ ПО НАСТРОЙКЕ
# ======================================
#
# 1. Скопируйте файл:
#    cp .env.docker.example .env
#
# 2. Заполните VERTEX_AI_PROJECT_ID вашим Google Cloud Project ID
#
# 3. Положите файл credentials.json в backend/credentials/
#    Или укажите другой путь в VERTEX_AI_CREDENTIALS_PATH
#
# 4. Измените POSTGRES_PASSWORD на свой безопасный пароль
#
# 5. Если используете внешний домен, обновите:
#    - CORS_ORIGINS (добавьте домен)
#    - NEXT_PUBLIC_API_URL (укажите публичный URL backend)
#
# 6. Запустите с помощью:
#    ./restart.sh
#
